import sys
A, B = map(int,sys.stdin.readline().split())
count=0
for num in range(A,B+1):
    my_number=num
    digit=0
    while my_number>0:
        last_digit=my_number%10
        digit=last_digit
        my_number=my_number//10
        if digit == 7:
            count+=1
            break
print(count)


#Digital Clock Repair
import sys
M, N = map(int,sys.stdin.readline().split())
count_min=0
for minute in range(M,N+1):
    my_minute=minute
    sum=0
    while my_minute>0:
        last_digit=my_minute%10
        sum+=last_digit
        my_minute=my_minute//10
    if sum%2==0:
        count_min+=1
print(count_min)


